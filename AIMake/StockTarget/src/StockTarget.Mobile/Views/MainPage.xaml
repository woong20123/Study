<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockTarget.Mobile.ViewModels"
             xmlns:conv="clr-namespace:StockTarget.Mobile.Converters"
             xmlns:loc="clr-namespace:StockTarget.Mobile.Localization"
             x:Class="StockTarget.Mobile.Views.MainPage"
             x:DataType="vm:MobileMainViewModel"
             Title="StockTarget">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Tr Main_Language}" Clicked="OnLanguageClicked" />
        <ToolbarItem Text="{loc:Tr Main_ImportJson}" Command="{Binding ImportJsonCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <conv:StatusToBgColorConverter x:Key="StatusToBg" />
        <conv:StatusToTextColorConverter x:Key="StatusToText" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Summary Bar -->
        <Border Grid.Row="0" Margin="12,8,12,4" Padding="12,8" BackgroundColor="#F1F5F9" StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                <Label Grid.Column="0" Text="{Binding Status}" VerticalOptions="Center" FontSize="13" TextColor="#475569" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="{Binding UsdKrwText}" VerticalOptions="Center" Margin="8,0" FontSize="13" TextColor="#2563EB" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="{loc:Tr Main_AddTarget}" Command="{Binding AddTargetCommand}" FontSize="12" Padding="10,6" HeightRequest="34" CornerRadius="6" />

                <!-- 필터: 매수가 필요한 종목(매수 · 필수매수 · 강력매수)만 보기 -->
                <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,4,0,0">
                    <Switch IsToggled="{Binding OnlyBuy}" VerticalOptions="Center" OnColor="#86EFAC" ThumbColor="#16A34A" />
                    <Label Text="{Binding OnlyBuyText}" VerticalOptions="Center" FontSize="13" TextColor="#0F172A">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOnlyBuyLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Target List with Pull-to-Refresh -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding VisibleTargets}" Margin="12,4" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50">
                        <Label Text="{Binding EmptyText}" HorizontalOptions="Center" FontSize="16" TextColor="#64748B" />
                        <Button Text="{loc:Tr Main_AddFirst}" Command="{Binding AddTargetCommand}" HorizontalOptions="Center"
                                IsVisible="{Binding ShowAddFirst}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MobileTargetRowViewModel">
                        <Border Margin="0,4" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="6">
                                <!-- Row 0: 종목명(크게) · 티커 · 목표 연도 | 괴리 · 판정 -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding GapText}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"
                                           TextColor="{Binding Status, Converter={StaticResource StatusToText}}" />
                                    <Border BackgroundColor="{Binding Status, Converter={StaticResource StatusToBg}}"
                                            Padding="8,2" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                        <Label Text="{Binding Verdict}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToText}}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Row 1: Prices Comparison -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{loc:Tr Main_PriceLabel}" FontSize="13" TextColor="#64748B" />
                                    <Label Grid.Column="1" Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />

                                    <Label Grid.Column="2" HorizontalOptions="End" Text="{Binding QuarterBuyLabel}" FontSize="13" TextColor="#64748B" />
                                    <Label Grid.Column="3" Text="{Binding BuyPriceText}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                </Grid>

                                <!-- Row 2: Buy Amount & Quantity -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <Label Grid.Column="0" Text="{Binding BuyAmountText}" FontSize="12" TextColor="#0284C7" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding BuySharesText}" FontSize="12" TextColor="#16A34A" FontAttributes="Bold" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
