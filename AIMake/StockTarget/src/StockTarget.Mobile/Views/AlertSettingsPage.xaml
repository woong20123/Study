<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockTarget.Mobile.ViewModels"
             xmlns:loc="clr-namespace:StockTarget.Mobile.Localization"
             x:Class="StockTarget.Mobile.Views.AlertSettingsPage"
             x:DataType="vm:AlertSettingsViewModel"
             Title="{loc:Tr Alert_Settings}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12">
            <Border Padding="16,12">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Tr Alert_WeeklyTitle}" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{loc:Tr Alert_WeeklyDesc}" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding WeeklyEnabled}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="16,12">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Tr Alert_DailyTitle}" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{loc:Tr Alert_DailyDesc}" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding DailyEnabled}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="{loc:Tr Alert_Note}" FontSize="12" TextColor="#64748B" Margin="4,0" />
            <Button Text="{loc:Tr Alert_Test}" Command="{Binding TestCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding Status}" FontSize="13" TextColor="#475569" Margin="4,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
