<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockTarget.Mobile.ViewModels"
             xmlns:loc="clr-namespace:StockTarget.Mobile.Localization"
             x:Class="StockTarget.Mobile.Views.TargetEditPage"
             x:DataType="vm:MobileTargetEditViewModel"
             Title="{loc:Tr Edit_Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="16">
            <!-- 기본 정보 -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr Edit_Basic}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                    <Label Text="{loc:Tr Edit_SymbolLabel}" FontSize="12" TextColor="#64748B" />
                    <Entry Text="{Binding Symbol}" Placeholder="{loc:Tr Edit_SymbolHint}" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{loc:Tr Edit_TargetYear}" FontSize="12" TextColor="#64748B" />
                            <Entry Text="{Binding TargetYear}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End">
                            <Stepper Minimum="2025" Maximum="2050" Increment="1" Value="{Binding TargetYear}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 목표 주가 산정 방식 -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr Edit_PriceSection}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{loc:Tr Edit_DirectMode}" VerticalOptions="Center" FontSize="13" />
                        <Switch IsToggled="{Binding UseDirectPrice}" />
                    </HorizontalStackLayout>

                    <!-- 직접 입력 시 -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding UseDirectPrice}">
                        <Label Text="{loc:Tr Edit_TargetPrice}" FontSize="12" TextColor="#64748B" />
                        <Entry Text="{Binding TargetPrice}" Placeholder="{loc:Tr Edit_TargetPriceHint}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- EPS × PER 산정 시 -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding UseEpsPer}">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{loc:Tr Edit_Eps}" FontSize="12" TextColor="#64748B" />
                            <Entry Text="{Binding Eps}" Placeholder="{loc:Tr Edit_EpsHint}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{loc:Tr Edit_Per}" FontSize="12" TextColor="#64748B" />
                            <Entry Text="{Binding Per}" Placeholder="{loc:Tr Edit_PerHint}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 수익률 및 배당 -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr Edit_ReturnSection}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                    <Label Text="{loc:Tr Edit_Return}" FontSize="12" TextColor="#64748B" />
                    <Entry Text="{Binding ReturnPct}" Placeholder="{loc:Tr Edit_ReturnHint}" Keyboard="Numeric" />

                    <Label Text="{loc:Tr Edit_Dividend}" FontSize="12" TextColor="#64748B" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding DividendYieldPct}" Placeholder="{loc:Tr Edit_DividendHint}" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="{loc:Tr Edit_FetchDividend}" Command="{Binding AutoFetchDividendCommand}" FontSize="12" Padding="12,0" HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 단계별 매수금액 (원) -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr Edit_AmountSection}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="{loc:Tr Edit_AmountNote}" FontSize="11" TextColor="#64748B" />

                    <Label Text="{loc:Tr Edit_BuyLabel}" FontSize="12" TextColor="#16A34A" FontAttributes="Bold" />
                    <Entry Text="{Binding BuyKrw}" Placeholder="{loc:Tr Edit_BuyHint}" />

                    <Label Text="{loc:Tr Edit_MustBuyLabel}" FontSize="12" TextColor="#0284C7" FontAttributes="Bold" />
                    <Entry Text="{Binding MustBuyKrw}" Placeholder="{loc:Tr Edit_MustBuyHint}" />

                    <Label Text="{loc:Tr Edit_StrongBuyLabel}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" />
                    <Entry Text="{Binding StrongBuyKrw}" Placeholder="{loc:Tr Edit_StrongBuyHint}" />
                </VerticalStackLayout>
            </Border>

            <!-- 메모 -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Tr Edit_Memo}" FontSize="12" TextColor="#64748B" />
                    <Entry Text="{Binding Memo}" Placeholder="{loc:Tr Edit_MemoHint}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Message}" FontSize="13" TextColor="#DC2626" HorizontalOptions="Center" />

            <!-- 저장 버튼 -->
            <Button Text="{loc:Tr Edit_Save}" Command="{Binding SaveCommand}" HeightRequest="50" FontSize="16" CornerRadius="10" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
