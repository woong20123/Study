<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockTarget.Mobile.ViewModels"
             xmlns:core="clr-namespace:StockTarget.Core;assembly=StockTarget.Core"
             xmlns:conv="clr-namespace:StockTarget.Mobile.Converters"
             x:Class="StockTarget.Mobile.Views.TargetDetailPage"
             x:DataType="vm:MobileTargetDetailViewModel"
             Title="종목 상세">

    <ContentPage.Resources>
        <conv:StatusToBgColorConverter x:Key="StatusToBg" />
        <conv:StatusToTextColorConverter x:Key="StatusToText" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="14">
            <!-- Header Summary Card -->
            <Border Padding="16">
                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding TargetRow.Symbol}" FontSize="22" FontAttributes="Bold" />
                        <Border Grid.Column="1" BackgroundColor="{Binding TargetRow.Status, Converter={StaticResource StatusToBg}}"
                                Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                            <Label Text="{Binding TargetRow.Verdict}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding TargetRow.Status, Converter={StaticResource StatusToText}}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="현재가" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.PriceText}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="이번분기 목표가" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.BuyPriceText}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="괴리율" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.GapText}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{Binding TargetRow.Status, Converter={StaticResource StatusToText}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Grid.Row="2" Text="{Binding TargetRow.BuyAmountText}" FontSize="13" TextColor="#0284C7" FontAttributes="Bold" />
                </Grid>
            </Border>

            <!-- Metrics Card -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="계산 기준" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding TargetRow.TargetYear, StringFormat='목표 연도: {0}년'}" FontSize="13" TextColor="#334155" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding TargetRow.TargetPrice, StringFormat='최종 목표가: ${0:N2}'}" FontSize="13" TextColor="#334155" />

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding TargetRow.ReturnPct, StringFormat='목표 수익률: {0:N1}%'}" FontSize="13" TextColor="#334155" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TargetRow.DividendYieldPct, StringFormat='5년 배당률: {0:N2}%'}" FontSize="13" TextColor="#334155" />

                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TargetRow.GrowthPct, StringFormat='필요 주가상승률: 연 {0:N2}%'}" FontSize="13" TextColor="#0969DA" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quarterly Buy Price Schedule -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="분기별 매입 목표가 일정" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <CollectionView ItemsSource="{Binding Schedule}" SelectionMode="None">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*, *, *" Padding="0,4" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="분기" FontAttributes="Bold" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="기준일" FontAttributes="Bold" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Column="2" Text="매입 목표가" FontAttributes="Bold" FontSize="12" TextColor="#64748B" HorizontalOptions="End" />
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:ScheduleRow">
                                <Grid ColumnDefinitions="*, *, *" Padding="0,6">
                                    <Label Grid.Column="0" Text="{Binding Quarter}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" />
                                    <Label Grid.Column="1" Text="{Binding BaseDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#64748B" />
                                    <Label Grid.Column="2" Text="{Binding BuyPrice, StringFormat='${0:N2}'}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" TextColor="#0969DA" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 5-Year Dividend History -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="최근 5년 배당 내역" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <CollectionView ItemsSource="{Binding DividendPeriods}" SelectionMode="None">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="2*, *, *, *" Padding="0,4" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="기간" FontAttributes="Bold" FontSize="11" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="배당금" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                                <Label Grid.Column="2" Text="평균가" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                                <Label Grid.Column="3" Text="수익률" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:DividendPeriod">
                                <Grid ColumnDefinitions="2*, *, *, *" Padding="0,5">
                                    <Label Grid.Column="0" Text="{Binding From, StringFormat='{0:yyyy-MM}'}" FontSize="11" TextColor="#334155" />
                                    <Label Grid.Column="1" Text="{Binding Dividend, StringFormat='${0:N2}'}" FontSize="12" HorizontalOptions="End" TextColor="#334155" />
                                    <Label Grid.Column="2" Text="{Binding AvgPrice, StringFormat='${0:N1}'}" FontSize="12" HorizontalOptions="End" TextColor="#64748B" />
                                    <Label Grid.Column="3" Text="{Binding YieldPct, StringFormat='{0:N2}%'}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" TextColor="#16A34A" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
