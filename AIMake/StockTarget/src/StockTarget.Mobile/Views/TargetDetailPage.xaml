<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockTarget.Mobile.ViewModels"
             xmlns:core="clr-namespace:StockTarget.Core;assembly=StockTarget.Core"
             xmlns:conv="clr-namespace:StockTarget.Mobile.Converters"
             xmlns:loc="clr-namespace:StockTarget.Mobile.Localization"
             x:Class="StockTarget.Mobile.Views.TargetDetailPage"
             x:DataType="vm:MobileTargetDetailViewModel"
             Title="{loc:Tr Detail_Title}">

    <ContentPage.Resources>
        <conv:StatusToBgColorConverter x:Key="StatusToBg" />
        <conv:StatusToTextColorConverter x:Key="StatusToText" />
        <conv:StatusToBadgeTextColorConverter x:Key="StatusToBadgeText" />
        <conv:StatusToBarOpacityConverter x:Key="StatusToBar" />
        <conv:StatusIsBuyConverter x:Key="StatusIsBuy" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="14">
            <!-- Header Summary Card -->
            <Border Padding="16">
                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding TargetRow.Title}" FontSize="22" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TargetRow.Subtitle}" FontSize="13" TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{Binding TargetRow.Status, Converter={StaticResource StatusToBg}}"
                                Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding TargetRow.Verdict}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{Binding TargetRow.Status, Converter={StaticResource StatusToBadgeText}}" />
                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center" HeightRequest="12"
                                                       IsVisible="{Binding TargetRow.Status, Converter={StaticResource StatusIsBuy}}">
                                    <BoxView WidthRequest="3.5" HeightRequest="5" CornerRadius="1" VerticalOptions="End"
                                             Color="{Binding TargetRow.Status, Converter={StaticResource StatusToBadgeText}}"
                                             Opacity="{Binding TargetRow.Status, Converter={StaticResource StatusToBar}, ConverterParameter=1}" />
                                    <BoxView WidthRequest="3.5" HeightRequest="8.5" CornerRadius="1" VerticalOptions="End"
                                             Color="{Binding TargetRow.Status, Converter={StaticResource StatusToBadgeText}}"
                                             Opacity="{Binding TargetRow.Status, Converter={StaticResource StatusToBar}, ConverterParameter=2}" />
                                    <BoxView WidthRequest="3.5" HeightRequest="12" CornerRadius="1" VerticalOptions="End"
                                             Color="{Binding TargetRow.Status, Converter={StaticResource StatusToBadgeText}}"
                                             Opacity="{Binding TargetRow.Status, Converter={StaticResource StatusToBar}, ConverterParameter=3}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{loc:Tr Detail_Price}" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.PriceText}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{loc:Tr Detail_QuarterTarget}" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.BuyPriceText}" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="{loc:Tr Detail_Gap}" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding TargetRow.GapText}" FontSize="15" FontAttributes="Bold" TextColor="#334155" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Grid.Row="2" Text="{Binding TargetRow.BuyAmountText}" FontSize="13" TextColor="#0284C7" FontAttributes="Bold" />
                </Grid>
            </Border>

            <!-- Metrics Card -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Detail_Basis}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding TargetRow.TargetYearLine}" FontSize="13" TextColor="#334155" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding TargetRow.TargetPriceLine}" FontSize="13" TextColor="#334155" />

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding TargetRow.ReturnLine}" FontSize="13" TextColor="#334155" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TargetRow.DividendLine}" FontSize="13" TextColor="#334155" />

                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TargetRow.GrowthLine}" FontSize="13" TextColor="#0969DA" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quarterly Buy Price Schedule -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Detail_Schedule}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <CollectionView ItemsSource="{Binding Schedule}" SelectionMode="None">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*, *, *" Padding="0,4" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="{loc:Tr Detail_Quarter}" FontAttributes="Bold" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{loc:Tr Detail_BaseDate}" FontAttributes="Bold" FontSize="12" TextColor="#64748B" />
                                <Label Grid.Column="2" Text="{loc:Tr Detail_BuyTarget}" FontAttributes="Bold" FontSize="12" TextColor="#64748B" HorizontalOptions="End" />
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:ScheduleRow">
                                <Grid ColumnDefinitions="*, *, *" Padding="0,6">
                                    <Label Grid.Column="0" Text="{Binding Quarter}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" />
                                    <Label Grid.Column="1" Text="{Binding BaseDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#64748B" />
                                    <Label Grid.Column="2" Text="{Binding BuyPrice, StringFormat='${0:N2}'}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" TextColor="#0969DA" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 5-Year Dividend History -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Detail_DividendHistory}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <CollectionView ItemsSource="{Binding DividendPeriods}" SelectionMode="None">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="2*, *, *, *" Padding="0,4" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="{loc:Tr Detail_Period}" FontAttributes="Bold" FontSize="11" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{loc:Tr Detail_DividendAmount}" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                                <Label Grid.Column="2" Text="{loc:Tr Detail_AvgPrice}" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                                <Label Grid.Column="3" Text="{loc:Tr Detail_Yield}" FontAttributes="Bold" FontSize="11" TextColor="#64748B" HorizontalOptions="End" />
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:DividendPeriod">
                                <Grid ColumnDefinitions="2*, *, *, *" Padding="0,5">
                                    <Label Grid.Column="0" Text="{Binding From, StringFormat='{0:yyyy-MM}'}" FontSize="11" TextColor="#334155" />
                                    <Label Grid.Column="1" Text="{Binding Dividend, StringFormat='${0:N2}'}" FontSize="12" HorizontalOptions="End" TextColor="#334155" />
                                    <Label Grid.Column="2" Text="{Binding AvgPrice, StringFormat='${0:N1}'}" FontSize="12" HorizontalOptions="End" TextColor="#64748B" />
                                    <Label Grid.Column="3" Text="{Binding YieldPct, StringFormat='{0:N2}%'}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" TextColor="#16A34A" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
