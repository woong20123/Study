    xmlns:views="clr-namespace:StockTarget.Mobile.Views"
    Title="StockTarget">

    <TabBar>
        <Tab Title="목표 종목">
            <ShellContent
                Title="목표 종목"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>
        <!-- LOC 예약 화면은 우선 비활성화 (다시 열려면 주석 해제)
        <Tab Title="LOC 예약" Icon="calendar_icon.png">
            <ShellContent
                Title="LOC 예약"
                ContentTemplate="{DataTemplate views:ReservationPage}"
                Route="ReservationPage" />
        </Tab>
        -->
    </TabBar>

</Shell>
