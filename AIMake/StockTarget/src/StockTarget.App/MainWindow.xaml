<Window x:Class="StockTarget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockTarget — 분기별 매입 목표가" Height="760" Width="1380"
        MinHeight="560" MinWidth="1000" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E3E6EA"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- 판정 색 (Status = Core.BuyStatus)
             강력매수(파란색, -20% 이하) / 필수매수(하늘색, -10% 이하) / 매수(녹색) / 매입 대기(연한 녹색, +5% 이내) / 대기(회색) -->
        <SolidColorBrush x:Key="StrongBuyBg" Color="#90CAF9"/>
        <SolidColorBrush x:Key="StrongBuyFg" Color="#0D47A1"/>
        <SolidColorBrush x:Key="MustBuyBg" Color="#D9F0FC"/>
        <SolidColorBrush x:Key="MustBuyFg" Color="#0277BD"/>
        <SolidColorBrush x:Key="BuyBg" Color="#C8E6C9"/>
        <SolidColorBrush x:Key="BuyFg" Color="#1B5E20"/>
        <SolidColorBrush x:Key="NearBg" Color="#EDF7EE"/>
        <SolidColorBrush x:Key="NearFg" Color="#388E3C"/>
        <SolidColorBrush x:Key="WaitBg" Color="#F1F2F4"/>
        <SolidColorBrush x:Key="WaitFg" Color="#6B7280"/>

        <Style x:Key="StatusRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="StrongBuy">
                    <Setter Property="Background" Value="{StaticResource StrongBuyBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MustBuy">
                    <Setter Property="Background" Value="{StaticResource MustBuyBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Buy">
                    <Setter Property="Background" Value="{StaticResource BuyBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Near">
                    <Setter Property="Background" Value="{StaticResource NearBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Wait">
                    <Setter Property="Background" Value="{StaticResource WaitBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="StrongBuy">
                    <Setter Property="Foreground" Value="{StaticResource StrongBuyFg}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MustBuy">
                    <Setter Property="Foreground" Value="{StaticResource MustBuyFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Buy">
                    <Setter Property="Foreground" Value="{StaticResource BuyFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Near">
                    <Setter Property="Foreground" Value="{StaticResource NearFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Wait">
                    <Setter Property="Foreground" Value="{StaticResource WaitFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 상태 표시줄 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F3F4F6">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="#777" Text="{Binding DbPath, StringFormat=DB: {0}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="440" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 목표 목록 + 입력 -->
            <DockPanel Grid.Column="0">
                <GroupBox DockPanel.Dock="Bottom" Header="목표 입력 (같은 티커로 저장하면 갱신)" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="티커"/>
                        <TextBox AutomationProperties.AutomationId="FormSymbol" Grid.Row="0" Grid.Column="1" Text="{Binding FormSymbol, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="목표 연도"/>
                        <TextBox AutomationProperties.AutomationId="FormYear" Grid.Row="0" Grid.Column="4" Text="{Binding FormYear, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Style="{StaticResource Label}" Text="목표 수익률(%)"/>
                        <TextBox AutomationProperties.AutomationId="FormReturn" Grid.Row="0" Grid.Column="7" Text="{Binding FormReturn, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="목표 EPS"/>
                        <TextBox AutomationProperties.AutomationId="FormEps" Grid.Row="1" Grid.Column="1" Text="{Binding FormEps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" Text="목표 PER"/>
                        <TextBox AutomationProperties.AutomationId="FormPer" Grid.Row="1" Grid.Column="4" Text="{Binding FormPer, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="6" Style="{StaticResource Label}" Text="배당수익률(%)"/>
                        <TextBox AutomationProperties.AutomationId="FormDividend" Grid.Row="1" Grid.Column="7" Text="{Binding FormDividend, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="비워 두면 최근 5년 평균 배당수익률을 조회해 고정한다"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="메모"/>
                        <TextBox AutomationProperties.AutomationId="FormMemo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding FormMemo, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="저장" Command="{Binding SaveCommand}" IsDefault="True"/>
                            <Button Content="삭제" Command="{Binding DeleteCommand}"/>
                            <Button Content="새로 입력" Command="{Binding NewCommand}"/>
                            <Button Content="시세 새로고침(캐시 무시)" Command="{Binding RefreshCommand}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#888" Margin="6,0,0,0"
                                       Text="배당수익률을 비우면 5년 평균을 자동 조회"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}" RowStyle="{StaticResource StatusRow}">
                    <DataGrid.Columns>
                        <!-- 판단에 쓰는 값(현재가 · 이번 분기 매입 목표가 · 괴리 · 판정)을 티커 바로 뒤에 둔다 -->
                        <DataGridTextColumn Header="티커" Binding="{Binding Symbol}" Width="Auto" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="현재가" Binding="{Binding Price, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="매입목표가" Binding="{Binding CurrentBuyPrice, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="괴리" Binding="{Binding GapPct, StringFormat={}{0:+0.0;-0.0}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="Auto" MinWidth="72" ElementStyle="{StaticResource StatusText}"/>
                        <DataGridTextColumn Header="분기" Binding="{Binding CurrentQuarter}" Width="Auto"/>
                        <DataGridTextColumn Header="목표연도" Binding="{Binding TargetYear}" Width="Auto"/>
                        <DataGridTextColumn Header="목표주가" Binding="{Binding TargetPrice, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="수익률" Binding="{Binding ReturnPct, StringFormat={}{0:0.##}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="배당(고정)" Binding="{Binding DividendYieldPct, StringFormat={}{0:0.00}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="필요상승률" Binding="{Binding GrowthPct, StringFormat={}{0:0.00}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="시세" Binding="{Binding CacheText}" Width="*" MinWidth="70" Foreground="#888"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 오른쪽: 선택한 목표 상세 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#F7F8FA" BorderBrush="#E3E6EA" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Consolas, Malgun Gothic" LineHeight="20"/>
                </Border>

                <TabControl>
                    <TabItem Header="분기 일정">
                        <DataGrid ItemsSource="{Binding Schedule}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="#FFF4D6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="분기" Binding="{Binding Quarter}" Width="62"/>
                                <DataGridTextColumn Header="기준일" Binding="{Binding BaseDate, StringFormat=yyyy-MM-dd}" Width="86"/>
                                <DataGridTextColumn Header="매입 목표가" Binding="{Binding BuyPrice, StringFormat=N2}" Width="86" ElementStyle="{StaticResource Num}"/>
                                <DataGridCheckBoxColumn Header="이번 분기" Binding="{Binding IsCurrent, Mode=OneWay}" Width="64"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="5년 배당 내역">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding DividendSummary}" TextWrapping="Wrap" Margin="4,8,4,4" LineHeight="20"/>
                            <DataGrid ItemsSource="{Binding DividendPeriods}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시작" Binding="{Binding From, StringFormat=yyyy-MM-dd}" Width="80"/>
                                    <DataGridTextColumn Header="끝" Binding="{Binding To, StringFormat=yyyy-MM-dd}" Width="80"/>
                                    <DataGridTextColumn Header="횟수" Binding="{Binding Count}" Width="40" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="배당금" Binding="{Binding Dividend, StringFormat=0.0000}" Width="62" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="평균주가" Binding="{Binding AvgPrice, StringFormat=N2}" Width="70" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="수익률" Binding="{Binding YieldPct, StringFormat={}{0:0.00}%}" Width="56" ElementStyle="{StaticResource Num}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="확인 이력">
                        <DataGrid ItemsSource="{Binding Checks}" RowStyle="{StaticResource StatusRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="확인일" Binding="{Binding CheckDate, StringFormat=yyyy-MM-dd}" Width="80"/>
                                <DataGridTextColumn Header="현재가" Binding="{Binding Price, StringFormat=N2}" Width="64" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="매입 목표가" Binding="{Binding BuyPrice, StringFormat=N2}" Width="74" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="괴리" Binding="{Binding GapPct, StringFormat={}{0:+0.0;-0.0}%}" Width="56" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="판정" Binding="{Binding StatusText}" Width="66" ElementStyle="{StaticResource StatusText}"/>
                                <DataGridTextColumn Header="분기" Binding="{Binding Quarter}" Width="56"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
