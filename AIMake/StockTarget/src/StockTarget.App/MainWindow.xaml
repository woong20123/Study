<Window x:Class="StockTarget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockTarget — 분기별 매입 목표가" Height="760" Width="1380"
        MinHeight="560" MinWidth="1000" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="13">

    <DockPanel>
        <!-- 상태 표시줄 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F3F4F6">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CloudStatus}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding UsdKrwText}" Margin="0,0,16,0"/>
                    <TextBlock Foreground="#777" Text="{Binding DbPath, StringFormat=DB: {0}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 백업 · 동기화 메뉴 -->
        <Menu DockPanel.Dock="Top" Padding="4,2" Background="#F3F4F6">
            <MenuItem Header="데이터(_D)">
                <MenuItem Header="JSON으로 내보내기..." Command="{Binding ExportJsonCommand}"/>
                <MenuItem Header="JSON에서 복원..." Command="{Binding ImportJsonCommand}"/>
                <Separator/>
                <MenuItem Header="Firebase에 저장" Command="{Binding CloudSaveCommand}"/>
                <MenuItem Header="Firebase에서 복원" Command="{Binding CloudRestoreCommand}"/>
                <Separator/>
                <MenuItem Header="Google 로그인" Command="{Binding CloudLoginCommand}"/>
                <MenuItem Header="Google 로그아웃" Command="{Binding CloudLogoutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="440" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 목표 목록 + 입력 -->
            <DockPanel Grid.Column="0">
                <!-- 기본 매수금액: 목표마다 따로 저장하지 않은 단계에 공통으로 쓴다 -->
                <GroupBox DockPanel.Dock="Top" Header="기본 매수금액 (목표에서 따로 저장하지 않은 단계에 적용)" Padding="8,4" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="DefaultBuyKrw" Grid.Row="0" Grid.Column="1" Text="{Binding DefaultBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '매수'일 때 기본으로 살 금액. 1,000,000 / 100만 처럼 입력, 0이면 사지 않음"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="필수매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="DefaultMustBuyKrw" Grid.Row="0" Grid.Column="4" Text="{Binding DefaultMustBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '필수매수'(매입 목표가 -10% 이하)일 때 기본으로 살 금액"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Style="{StaticResource Label}" Text="강력매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="DefaultStrongBuyKrw" Grid.Row="0" Grid.Column="7" Text="{Binding DefaultStrongBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '강력매수'(매입 목표가 -20% 이하)일 때 기본으로 살 금액"/>
                        <StackPanel Grid.Row="0" Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button AutomationProperties.AutomationId="SaveDefaults" Content="기본값 저장" Command="{Binding SaveDefaultsCommand}"/>
                            <Button Content="되돌리기" Command="{Binding RevertDefaultsCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" Text="{Binding DefaultBuyUsd}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" Text="{Binding DefaultMustBuyUsd}"/>
                        <TextBlock Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" Text="{Binding DefaultStrongBuyUsd}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10" Foreground="#888" Margin="0,2,0,0" Text="{Binding DefaultsSummary}"/>
                    </Grid>
                </GroupBox>

                <GroupBox DockPanel.Dock="Bottom" Header="목표 입력 (같은 티커로 저장하면 갱신)" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="티커"/>
                        <TextBox AutomationProperties.AutomationId="FormSymbol" Grid.Row="0" Grid.Column="1" Text="{Binding FormSymbol, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="목표 연도"/>
                        <TextBox AutomationProperties.AutomationId="FormYear" Grid.Row="0" Grid.Column="4" Text="{Binding FormYear, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Style="{StaticResource Label}" Text="목표 수익률(%)"/>
                        <TextBox AutomationProperties.AutomationId="FormReturn" Grid.Row="0" Grid.Column="7" Text="{Binding FormReturn, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 목표 주가: EPS × PER로 계산하거나 직접 입력 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="목표 주가"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton AutomationProperties.AutomationId="FormEpsPerMode" GroupName="TargetPriceMode" Content="EPS × PER" Margin="0,0,12,0"
                                         IsChecked="{Binding FormEpsPerMode}"/>
                            <RadioButton AutomationProperties.AutomationId="FormDirectPrice" GroupName="TargetPriceMode" Content="직접 입력"
                                         IsChecked="{Binding FormDirectPrice}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" Text="목표 주가"/>
                        <TextBox AutomationProperties.AutomationId="FormTargetPrice" Grid.Row="1" Grid.Column="4" Text="{Binding FormTargetPrice, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding FormDirectPrice}" ToolTip="'직접 입력'을 선택하면 EPS × PER 대신 이 값을 목표 주가로 쓴다"/>
                        <TextBlock Grid.Row="1" Grid.Column="6" Style="{StaticResource Label}" Text="배당수익률(%)"/>
                        <TextBox AutomationProperties.AutomationId="FormDividend" Grid.Row="1" Grid.Column="7" Text="{Binding FormDividend, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="비워 두면 최근 5년 평균 배당수익률을 조회해 고정한다"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="목표 EPS"/>
                        <TextBox AutomationProperties.AutomationId="FormEps" Grid.Row="2" Grid.Column="1" Text="{Binding FormEps, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding FormEpsPerMode}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Label}" Text="목표 PER"/>
                        <TextBox AutomationProperties.AutomationId="FormPer" Grid.Row="2" Grid.Column="4" Text="{Binding FormPer, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding FormEpsPerMode}"/>
                        <TextBlock Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#777" Text="{Binding FormEpsPerPreview}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="메모"/>
                        <TextBox AutomationProperties.AutomationId="FormMemo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding FormMemo, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 매수 단계별 매수금액(원). 기본 매수금액으로 채워지고, 기본값과 다른 단계만 이 목표에 저장한다 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="FormBuyKrw" Grid.Row="4" Grid.Column="1" Text="{Binding FormBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '매수'일 때 살 금액. 기본값과 다르게 입력한 단계만 이 목표에 저장, 비우면 기본값, 0이면 사지 않음"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Label}" Text="필수매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="FormMustBuyKrw" Grid.Row="4" Grid.Column="4" Text="{Binding FormMustBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '필수매수'(매입 목표가 -10% 이하)일 때 살 금액"/>
                        <TextBlock Grid.Row="4" Grid.Column="6" Style="{StaticResource Label}" Text="강력매수(원)"/>
                        <TextBox AutomationProperties.AutomationId="FormStrongBuyKrw" Grid.Row="4" Grid.Column="7" Text="{Binding FormStrongBuyKrw, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right" ToolTip="판정이 '강력매수'(매입 목표가 -20% 이하)일 때 살 금액"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" TextAlignment="Right" Text="{Binding FormBuyUsd}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" TextAlignment="Right" Text="{Binding FormMustBuyUsd}"/>
                        <TextBlock Grid.Row="5" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource Num}" Foreground="#777" TextAlignment="Right" Text="{Binding FormStrongBuyUsd}"/>

                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="저장" Command="{Binding SaveCommand}" IsDefault="True"/>
                            <Button Content="삭제" Command="{Binding DeleteCommand}"/>
                            <Button Content="새로 입력" Command="{Binding NewCommand}"/>
                            <Button Content="시세 새로고침(캐시 무시)" Command="{Binding RefreshCommand}"/>
                            <Button AutomationProperties.AutomationId="OpenReservation" Content="다음 주 LOC 예약..." Command="{Binding ReserveCommand}"
                                    ToolTip="현재가가 이미 도달한 단계만 골라 다음 주(월~금) LOC 예약 매수 주문표를 만든다(나머지는 제외 목록에 사유 표시). 접수는 증권사 앱에서 직접"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#888" Margin="6,0,0,0"
                                       Text="배당수익률을 비우면 5년 평균을 자동 조회"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}" RowStyle="{StaticResource StatusRow}">
                    <DataGrid.Columns>
                        <!-- 종목명 · 티커 다음에 판단에 쓰는 값(현재가 · 이번 분기 매입 목표가 · 괴리 · 판정)을 둔다 -->
                        <DataGridTextColumn Header="종목명" Binding="{Binding Name}" Width="Auto" MaxWidth="180"/>
                        <DataGridTextColumn Header="티커" Binding="{Binding Symbol}" Width="Auto" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="현재가" Binding="{Binding Price, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="매입목표가" Binding="{Binding CurrentBuyPrice, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="괴리" Binding="{Binding GapPct, StringFormat={}{0:+0.0;-0.0}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="Auto" MinWidth="72" ElementStyle="{StaticResource StatusText}"/>
                        <DataGridTextColumn Header="매수금액" Binding="{Binding BuyAmountText}" Width="Auto" MinWidth="200" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="매수단가 × 수량" Binding="{Binding BuySharesText}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="분기" Binding="{Binding CurrentQuarter}" Width="Auto"/>
                        <DataGridTextColumn Header="목표연도" Binding="{Binding TargetYear}" Width="Auto"/>
                        <DataGridTextColumn Header="목표주가" Binding="{Binding TargetPrice, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="수익률" Binding="{Binding ReturnPct, StringFormat={}{0:0.##}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="배당(고정)" Binding="{Binding DividendYieldPct, StringFormat={}{0:0.00}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="필요상승률" Binding="{Binding GrowthPct, StringFormat={}{0:0.00}%}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="시세" Binding="{Binding CacheText}" Width="*" MinWidth="70" Foreground="#888"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 오른쪽: 선택한 목표 상세 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#F7F8FA" BorderBrush="#E3E6EA" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Consolas, Malgun Gothic" LineHeight="20"/>
                </Border>

                <TabControl>
                    <TabItem Header="분기 일정">
                        <DataGrid ItemsSource="{Binding Schedule}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="#FFF4D6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="분기" Binding="{Binding Quarter}" Width="62"/>
                                <DataGridTextColumn Header="기준일" Binding="{Binding BaseDate, StringFormat=yyyy-MM-dd}" Width="86"/>
                                <DataGridTextColumn Header="매입 목표가" Binding="{Binding BuyPrice, StringFormat=N2}" Width="86" ElementStyle="{StaticResource Num}"/>
                                <DataGridCheckBoxColumn Header="이번 분기" Binding="{Binding IsCurrent, Mode=OneWay}" Width="64"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="5년 배당 내역">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding DividendSummary}" TextWrapping="Wrap" Margin="4,8,4,4" LineHeight="20"/>
                            <DataGrid ItemsSource="{Binding DividendPeriods}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시작" Binding="{Binding From, StringFormat=yyyy-MM-dd}" Width="80"/>
                                    <DataGridTextColumn Header="끝" Binding="{Binding To, StringFormat=yyyy-MM-dd}" Width="80"/>
                                    <DataGridTextColumn Header="횟수" Binding="{Binding Count}" Width="40" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="배당금" Binding="{Binding Dividend, StringFormat=0.0000}" Width="62" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="평균주가" Binding="{Binding AvgPrice, StringFormat=N2}" Width="70" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="수익률" Binding="{Binding YieldPct, StringFormat={}{0:0.00}%}" Width="56" ElementStyle="{StaticResource Num}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="확인 이력">
                        <DataGrid ItemsSource="{Binding Checks}" RowStyle="{StaticResource StatusRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="확인일" Binding="{Binding CheckDate, StringFormat=yyyy-MM-dd}" Width="80"/>
                                <DataGridTextColumn Header="현재가" Binding="{Binding Price, StringFormat=N2}" Width="64" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="매입 목표가" Binding="{Binding BuyPrice, StringFormat=N2}" Width="74" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="괴리" Binding="{Binding GapPct, StringFormat={}{0:+0.0;-0.0}%}" Width="56" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn Header="판정" Binding="{Binding StatusText}" Width="66" ElementStyle="{StaticResource StatusText}"/>
                                <DataGridTextColumn Header="분기" Binding="{Binding Quarter}" Width="56"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
