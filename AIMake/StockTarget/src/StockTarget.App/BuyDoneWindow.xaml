<Window x:Class="StockTarget.App.BuyDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="매수 완료 관리" Height="460" Width="720"
        MinHeight="300" MinWidth="520" WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="닫기" Click="OnClose" IsCancel="True"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <!-- 한 번 클릭으로 바로 켜고 끈다(DataGridCheckBoxColumn은 셀 선택 후 한 번 더 눌러야 한다) -->
                <DataGridTemplateColumn Header="매수 완료" Width="Auto" SortMemberPath="IsDone">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsDone, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="종목명" Binding="{Binding Row.Name}" Width="Auto" MaxWidth="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="티커" Binding="{Binding Row.Symbol}" Width="Auto" FontWeight="SemiBold" IsReadOnly="True"/>
                <DataGridTextColumn Header="판정" Binding="{Binding Row.Verdict}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="매수단가 × 수량" Binding="{Binding Row.BuySharesText}" Width="Auto" ElementStyle="{StaticResource Num}" IsReadOnly="True"/>
                <DataGridTextColumn Header="매수금액" Binding="{Binding Row.BuyAmountText}" Width="*" ElementStyle="{StaticResource Num}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
