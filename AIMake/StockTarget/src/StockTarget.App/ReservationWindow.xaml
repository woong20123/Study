<Window x:Class="StockTarget.App.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다음 주 LOC 예약 매수 (키움)" Height="640" Width="1100"
        MinHeight="420" MinWidth="820" WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13">
    <DockPanel Margin="10">
        <!-- 기간 · 접수 대상 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding EnvText}" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#555"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRealEnv}" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Summary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 버튼 · 상태 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="주문표 다시 계산(환율 갱신)" Command="{Binding RefreshCommand}"/>
                <Button AutomationProperties.AutomationId="SubmitReservation" Content="키움에 예약 접수..." Command="{Binding SubmitCommand}" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#555" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TabControl>
            <TabItem Header="주문표">
                <DockPanel>
                    <!-- 제외된 목표와 사유 -->
                    <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding Skips}" MaxHeight="130" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="제외" Binding="{Binding Symbol}" Width="70" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid ItemsSource="{Binding Rows}" RowStyle="{StaticResource StatusRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="티커" Binding="{Binding Symbol}" Width="Auto" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="단계" Binding="{Binding StageText}" Width="Auto" ElementStyle="{StaticResource StatusText}"/>
                            <DataGridTextColumn Header="기간" Binding="{Binding Period}" Width="Auto"/>
                            <DataGridTextColumn Header="매입목표가" Binding="{Binding BuyPrice, StringFormat=N3}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn Header="LOC 주문가" Binding="{Binding Price, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="Auto" ElementStyle="{StaticResource Num}" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="주문금액($)" Binding="{Binding OrderUsd, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn Header="단계 금액" Binding="{Binding AmountText}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn Header="접수 결과" Binding="{Binding Result}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="접수 이력">
                <DataGrid ItemsSource="{Binding History}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="접수 시각" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto"/>
                        <DataGridTextColumn Header="환경" Binding="{Binding Env}" Width="Auto"/>
                        <DataGridTextColumn Header="티커" Binding="{Binding Symbol}" Width="Auto" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="단계" Binding="{Binding Stage}" Width="Auto"/>
                        <DataGridTextColumn Header="시작" Binding="{Binding Start, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                        <DataGridTextColumn Header="종료" Binding="{Binding End, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                        <DataGridTextColumn Header="주문가" Binding="{Binding Price, StringFormat=N2}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="Auto" ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="예약번호" Binding="{Binding ReservationNo}" Width="Auto"/>
                        <DataGridTextColumn Header="주문예정일" Binding="{Binding ScheduledDate}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
